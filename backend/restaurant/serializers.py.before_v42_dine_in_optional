SALAMANCA_CENTER_LAT = 40.9701
SALAMANCA_CENTER_LON = -5.6635
SALAMANCA_MAX_DISTANCE_KM = 8.0

SALAMANCA_STREET_FALLBACKS = {
    "calle toro": (40.96530, -5.66420, "Calle Toro, 37002 Salamanca, España"),
    "toro": (40.96530, -5.66420, "Calle Toro, 37002 Salamanca, España"),
    "gran via": (40.96370, -5.66170, "Gran Via, 37001 Salamanca, España"),
    "gran vía": (40.96370, -5.66170, "Gran Via, 37001 Salamanca, España"),
    "calle rollo": (40.96870, -5.65090, "Calle Rollo, Salamanca, España"),
    "rollo": (40.96870, -5.65090, "Calle Rollo, Salamanca, España"),
}


def _sal_distance_km(lat1, lon1, lat2, lon2):
    try:
        lat1, lon1, lat2, lon2 = map(float, [lat1, lon1, lat2, lon2])
        r = 6371
        dlat = math.radians(lat2 - lat1)
        dlon = math.radians(lon2 - lon1)
        a = (
            math.sin(dlat / 2) ** 2
            + math.cos(math.radians(lat1))
            * math.cos(math.radians(lat2))
            * math.sin(dlon / 2) ** 2
        )
        return r * (2 * math.atan2(math.sqrt(a), math.sqrt(1 - a)))
    except Exception:
        return 9999


def normalize_salamanca_address(address):
    raw = str(address or "").strip()
    raw = re.sub(r"\s+", " ", raw)

    if not raw:
        return ""

    lower = raw.lower().strip()

    aliases = [
        ("toro", "Calle Toro"),
        ("calle toro", "Calle Toro"),
        ("c/ toro", "Calle Toro"),
        ("rollo", "Calle Rollo"),
        ("calle rollo", "Calle Rollo"),
        ("c/ rollo", "Calle Rollo"),
        ("gran via", "Gran Via"),
        ("gran vía", "Gran Via"),
        ("calle gran via", "Gran Via"),
        ("calle gran vía", "Gran Via"),
    ]

    for key, value in aliases:
        if lower == key or lower.startswith(key + " "):
            suffix = raw[len(key):].strip()
            raw = f"{value} {suffix}".strip()
            break

    lower = raw.lower()

    street_words = [
        "calle", "c/", "avenida", "av.", "plaza", "paseo",
        "camino", "carretera", "gran via", "gran vía"
    ]

    if not any(w in lower for w in street_words):
        raw = f"Calle {raw}"

    if "salamanca" not in raw.lower():
        raw = f"{raw}, Salamanca, España"

    if "calle toro" in raw.lower() and "37002" not in raw:
        raw = raw.replace(", Salamanca", ", 37002 Salamanca")

    if ("gran via" in raw.lower() or "gran vía" in raw.lower()) and "37001" not in raw:
        raw = raw.replace(", Salamanca", ", 37001 Salamanca")

    return raw


def _is_valid_salamanca_result(item):
    lat = item.get("lat")
    lon = item.get("lon")
    display = str(item.get("display_name", ""))
    display_lower = display.lower()

    if _sal_distance_km(SALAMANCA_CENTER_LAT, SALAMANCA_CENTER_LON, lat, lon) > SALAMANCA_MAX_DISTANCE_KM:
        return False

    forbidden = [
        "alba de tormes",
        "peñaranda",
        "penaranda",
        "villamayor",
        "santa marta de tormes",
        "cabrerizos",
        "carbajosa",
    ]

    if any(x in display_lower for x in forbidden):
        return False

    return "salamanca" in display_lower


def fallback_salamanca_coordinates(address):
    lower = str(address or "").lower()
    lower = lower.replace(",", " ")
    lower = re.sub(r"\s+", " ", lower).strip()

    for key, (lat, lon, label) in SALAMANCA_STREET_FALLBACKS.items():
        if key in lower:
            return str(lat), str(lon), label

    return None, None, ""


def geocode_customer_address_salamanca(address):
    normalized = normalize_salamanca_address(address)

    if not normalized:
        return None, None, ""

    street = normalized.split(",")[0].strip()
    street_without_number = re.sub(r"\d+", "", street).strip()
    viewbox = "-5.72,41.01,-5.60,40.93"

    queries = [
        {
            "format": "json",
            "street": street,
            "city": "Salamanca",
            "country": "España",
            "countrycodes": "es",
            "viewbox": viewbox,
            "bounded": 1,
            "limit": 5,
            "addressdetails": 1,
        },
        {
            "format": "json",
            "q": normalized,
            "countrycodes": "es",
            "viewbox": viewbox,
            "bounded": 1,
            "limit": 5,
            "addressdetails": 1,
        },
        {
            "format": "json",
            "q": f"{street_without_number}, Salamanca, España",
            "countrycodes": "es",
            "viewbox": viewbox,
            "bounded": 1,
            "limit": 5,
            "addressdetails": 1,
        },
    ]

    for params in queries:
        try:
            response = requests.get(
                "https://nominatim.openstreetmap.org/search",
                params=params,
                headers={"User-Agent": "CasaDeKebabTurco/1.0"},
                timeout=8,
            )
            data = response.json()

            for item in data:
                if _is_valid_salamanca_result(item):
                    return item.get("lat"), item.get("lon"), item.get("display_name", "")
        except Exception:
            continue

    return fallback_salamanca_coordinates(normalized)


class CustomerSerializer(serializers.ModelSerializer):
    last_order_id = serializers.SerializerMethodField()
    last_order_total = serializers.SerializerMethodField()
    top_food = serializers.SerializerMethodField()
    top_food_quantity = serializers.SerializerMethodField()

    class Meta:
        model = Customer
        fields = [
            "id",
            "name",
            "phone",
            "address",
            "last_order_at",
            "total_orders",
            "total_spent",
            "created_at",
            "updated_at",
            "last_order_id",
            "last_order_total",
            "top_food",
            "top_food_quantity",
        ]

    def get_last_order_id(self, obj):
        last_order = Order.objects.filter(customer_phone=obj.phone).order_by("-created_at").first()
        return last_order.id if last_order else None

    def get_last_order_total(self, obj):
        last_order = Order.objects.filter(customer_phone=obj.phone).order_by("-created_at").first()
        return last_order.total_amount if last_order else None

    def get_top_food(self, obj):
        row = (
            OrderItem.objects
            .filter(order__customer_phone=obj.phone)
            .exclude(order__status="cancelled")
            .values("menu_item__name")
            .annotate(total_qty=models.Sum("quantity"))
            .order_by("-total_qty")
            .first()
        )
        return row["menu_item__name"] if row else ""

    def get_top_food_quantity(self, obj):
        row = (
            OrderItem.objects
            .filter(order__customer_phone=obj.phone)
            .exclude(order__status="cancelled")
            .values("menu_item__name")
            .annotate(total_qty=models.Sum("quantity"))
            .order_by("-total_qty")
            .first()
        )
        return row["total_qty"] if row else 0




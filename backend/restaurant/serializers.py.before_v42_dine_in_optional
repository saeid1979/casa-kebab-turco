class OrderSerializer(serializers.ModelSerializer):
    items = OrderItemReadSerializer(many=True, read_only=True)
    order_items = OrderItemWriteSerializer(many=True, write_only=True)
    whatsapp_url = serializers.SerializerMethodField()
    telegram_notification = serializers.SerializerMethodField()

    class Meta:
        model = Order
        fields = [
            "id",
            "customer_name",
            "customer_phone",
            "customer_address",
            "customer_geocoded_address",
            "customer_longitude",
            "customer_latitude",
            "order_type",
            "status",
            "notes",
            "total_amount",
            "cost_amount",
            "profit_amount",
            "payment_method",
            "payment_status",
            "payment_reference",
            "bank_transaction_id",
            "created_at",
            "items",
            "order_items",
            "whatsapp_url",
            "telegram_notification",
        ]
        read_only_fields = [
            "total_amount",
            "cost_amount",
            "profit_amount",
            "payment_reference",
            "bank_transaction_id",
            "created_at",
        ]

    def get_whatsapp_url(self, obj):
        try:
            from .notifications import build_whatsapp_url
            return build_whatsapp_url(obj)
        except Exception:
            return ""

    def get_telegram_notification(self, obj):
        return getattr(obj, "_telegram_notification", None)

    def create(self, validated_data):

        # v42.6 Online payment safety guard
        requested_payment_method = validated_data.get("payment_method")
        online_enabled = os.getenv("ONLINE_PAYMENT_ENABLED", "0") == "1"

        if requested_payment_method == "online_card" and not online_enabled:
            raise serializers.ValidationError({
                "payment_method": "El pago online no está disponible todavía. Usa efectivo o tarjeta al recibir."
            })

        if requested_payment_method == "online_card":
            validated_data["payment_status"] = "pending_payment"

        now = timezone.localtime(timezone.now(), ZoneInfo("Europe/Madrid"))
        current_minutes = now.hour * 60 + now.minute

        # Restaurant ordering hours: 11:30 AM to 01:00 AM Spain time
        is_open = current_minutes >= (11 * 60 + 30) or current_minutes < 60

       # if not is_open:
       #     raise serializers.ValidationError({
       #         "detail": "El horario de pedidos del restaurante es de 11:30 a 01:00."
       #     })


        order_items = validated_data.pop("order_items", [])
        payment_method = validated_data.get("payment_method", "cash_delivery")

        if payment_method in ["cash_delivery", "card_delivery"]:
            validated_data["payment_status"] = "pay_on_delivery"
        elif payment_method == "online_card":
            validated_data["payment_status"] = "pending"

        phone = validated_data.get("customer_phone", "").strip()
        name = validated_data.get("customer_name", "").strip()
        address = validated_data.get("customer_address", "").strip()

        if address:
            normalized_address = normalize_salamanca_address(address)
            validated_data["customer_address"] = normalized_address
            address = normalized_address

        customer_obj = None
        if phone:
            customer_obj, _ = Customer.objects.update_or_create(
                phone=phone,
                defaults={
                    "name": name,
                    "address": address,
                    "last_order_at": timezone.now(),
                },
            )

        order = Order.objects.create(**validated_data)

        lat, lon, display = geocode_customer_address_salamanca(order.customer_address)

        # Direct fallback inside create(): never leave known Salamanca streets without coordinates.
        if not lat or not lon:
            lat, lon, display = fallback_salamanca_coordinates(order.customer_address)

        if lat and lon:
            order.customer_latitude = lat
            order.customer_longitude = lon
            order.customer_geocoded_address = display
            order.save(update_fields=["customer_latitude", "customer_longitude", "customer_geocoded_address"])


        total = Decimal("0")
        material_cost = Decimal("0")

        for item in order_items:
            menu_item = MenuItem.objects.get(id=item["menu_item_id"])
            quantity = item["quantity"]
            unit_price = menu_item.price
            line_total = unit_price * quantity

            OrderItem.objects.create(
                order=order,
                menu_item=menu_item,
                quantity=quantity,
                unit_price=unit_price,
                line_total=line_total,
            )

            total += line_total

            if hasattr(menu_item, "ingredients"):
                for ingredient in menu_item.ingredients.select_related("inventory_item").all():
                    used_quantity = ingredient.quantity_required * quantity
                    inventory_item = ingredient.inventory_item
                    inventory_item.current_stock = inventory_item.current_stock - used_quantity
                    inventory_item.save(update_fields=["current_stock"])
                    material_cost += used_quantity * inventory_item.unit_cost

        order.total_amount = total
        order.cost_amount = material_cost if material_cost > 0 else total * Decimal("0.55")
        order.profit_amount = order.total_amount - order.cost_amount
        order.save()

        if customer_obj:
            customer_orders = Order.objects.filter(customer_phone=phone)
            customer_obj.total_orders = customer_orders.count()
            customer_obj.total_spent = (
                customer_orders.exclude(status="cancelled").aggregate(total=models.Sum("total_amount"))["total"]
                or Decimal("0")
            )
            customer_obj.last_order_at = order.created_at
            customer_obj.save(update_fields=["total_orders", "total_spent", "last_order_at", "updated_at"])

        try:
            from .notifications import send_order_to_telegram
            telegram_ok, telegram_message = send_order_to_telegram(order)
            order._telegram_notification = {
                "sent": telegram_ok,
                "message": telegram_message,
            }
        except Exception as exc:
            order._telegram_notification = {
                "sent": False,
                "message": str(exc),
            }


        # v42.3 Payment ledger auto-create
        if order.payment_method == "cash_delivery":
            payment_method_for_ledger = "cash"
        elif order.payment_method == "card_delivery" or (order.payment_method == "online_card" and order.payment_status == "paid"):
            payment_method_for_ledger = "card"
        else:
            payment_method_for_ledger = "cash"

        Payment.objects.update_or_create(
            order=order,
            defaults={
                "method": payment_method_for_ledger,
                "amount": order.total_amount,
                "discount_amount": Decimal("0"),
                "debt_amount": Decimal("0"),
                "notes": "Auto-created from order",
            }
        )

        return order



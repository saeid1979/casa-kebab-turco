:root {
  font-family: Inter, Arial, sans-serif;
  color: #172033;
  background: #f7f3ec;
}

body {
  margin: 0;
}

.header {
  background: linear-gradient(135deg, #120d09, #28180f);
  color: white;
  padding: 22px 32px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 28px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 16px;
}

.logo {
  background: #f59e0b;
  color: #16120f;
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border-radius: 18px;
}

h1, h2, h3, p {
  margin-top: 0;
}

.header h1 {
  margin-bottom: 4px;
}

.header p {
  margin-bottom: 0;
  color: #fcd9a0;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.language-switch {
  background: rgba(255,255,255,.1);
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 18px;
  padding: 8px;
  display: flex;
  align-items: center;
  gap: 7px;
}

.language-switch span {
  color: #ffe4b8;
  font-size: 14px;
}

nav {
  display: flex;
  gap: 10px;
}

button {
  border: 0;
  padding: 11px 15px;
  border-radius: 12px;
  cursor: pointer;
  background: #efe6d8;
  font-weight: 700;
}

button:hover, button.active, .primary {
  background: #f59e0b;
  color: #16120f;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 24px;
  padding: 28px;
}

.stack {
  padding: 28px;
  display: grid;
  gap: 22px;
}

.card {
  background: white;
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 14px 35px rgba(0,0,0,.08);
}

.wide {
  min-height: 520px;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 18px;
}

.menu-card {
  background: #fff8ed;
  border: 1px solid #f0ddbd;
  border-radius: 20px;
  padding: 18px;
  display: grid;
  gap: 12px;
  min-height: 180px;
}

.menu-card strong {
  font-size: 20px;
}

.cart-row {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid #eee;
  padding: 10px 0;
}

input, textarea, select {
  width: 100%;
  box-sizing: border-box;
  margin: 7px 0;
  padding: 12px;
  border-radius: 12px;
  border: 1px solid #ddd;
  font: inherit;
}

.message {
  background: #fef3c7;
  border-radius: 12px;
  padding: 12px;
  margin-top: 12px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.stat, .account-grid div {
  background: white;
  border-radius: 22px;
  padding: 20px;
  box-shadow: 0 14px 35px rgba(0,0,0,.07);
  display: grid;
  gap: 8px;
}

.stat b, .account-grid b {
  font-size: 28px;
}

.account-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  text-align: left;
  padding: 14px;
  border-bottom: 1px solid #eee;
}

.badge {
  background: #e9f5ff;
  padding: 7px 10px;
  border-radius: 999px;
  font-weight: 700;
}

@media (max-width: 900px) {
  .header, .grid {
    grid-template-columns: 1fr;
    flex-direction: column;
    align-items: flex-start;
  }

  .top-actions {
    justify-content: flex-start;
  }

  nav {
    flex-wrap: wrap;
  }

  .stats, .account-grid {
    grid-template-columns: 1fr;
  }
}


.admin-title {
  background: white;
  border-radius: 24px;
  padding: 22px;
  box-shadow: 0 14px 35px rgba(0,0,0,.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
}

.admin-title p {
  margin-bottom: 0;
  color: #6b7280;
}

.form-grid {
  display: grid;
  grid-template-columns: 1.2fr .7fr .8fr .7fr;
  gap: 12px;
  align-items: center;
}

.check {
  background: #fff8ed;
  border: 1px solid #f0ddbd;
  border-radius: 14px;
  padding: 12px;
}

.small-input {
  max-width: 120px;
}

.primary svg, .admin-title button svg {
  vertical-align: middle;
  margin-right: 6px;
}

@media (max-width: 900px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .admin-title {
    align-items: flex-start;
    flex-direction: column;
  }
}


.login-wrap {
  min-height: calc(100vh - 100px);

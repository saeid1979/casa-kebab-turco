.food-image {
  width: 100%;
  height: 135px;
  object-fit: cover;
  border-radius: 16px;
  margin-bottom: 4px;
  background: #f3f4f6;
}

.food-placeholder {
  width: 100%;
  height: 135px;
  border-radius: 16px;
  background: linear-gradient(135deg, #f59e0b, #fed7aa);
  color: #3b2208;
  display: grid;
  place-items: center;
  font-weight: 800;
  margin-bottom: 4px;
}

.image-upload-row {
  display: grid;
  grid-template-columns: 1fr 160px;
  gap: 14px;
  align-items: stretch;
  margin: 10px 0 14px;
}

.image-upload {
  background: #fff8ed;
  border: 1px dashed #d97706;
  border-radius: 16px;
  padding: 15px;
  display: grid;
  gap: 10px;
  cursor: pointer;
}

.image-upload input {
  background: white;
}

.image-preview-box {
  min-height: 118px;
  border-radius: 16px;
  border: 1px solid #e5e7eb;
  background: #f9fafb;
  display: grid;
  place-items: center;
  color: #6b7280;
  overflow: hidden;
}

.image-preview-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.table-food-image {
  width: 70px;
  height: 52px;
  object-fit: cover;
  border-radius: 10px;
  background: #f3f4f6;
}

.muted {
  color: #9ca3af;
  font-size: 13px;
}

@media (max-width: 900px) {
  .image-upload-row {
    grid-template-columns: 1fr;
  }
}


/* v6.2 layout and cart controls */
.grid {
  grid-template-columns: minmax(0, 1fr) 360px;
  align-items: start;
}

.grid .card {
  align-self: start;
}

.menu-grid {
  grid-template-columns: repeat(4, minmax(150px, 1fr));
  gap: 14px;
}

.menu-card {
  padding: 14px;
  min-height: 0;
  gap: 9px;
}

.menu-card h3 {
  font-size: 18px;
  margin-bottom: 4px;
}

.menu-card p {
  font-size: 14px;
  line-height: 1.25;
  margin-bottom: 4px;
}

.menu-card strong {
  font-size: 19px;
}

.menu-card button {
  padding: 10px 12px;
}

.food-image,
.food-placeholder {
  height: 105px;
  border-radius: 14px;
}

.cart-row-with-controls {
  display: grid;
  gap: 8px;
  padding: 12px 0;
}

.cart-item-title {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.qty-controls {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #fff8ed;
  border: 1px solid #f0ddbd;
  border-radius: 14px;
  padding: 6px;
  width: fit-content;
}

.qty-controls button {
  width: 34px;
  height: 30px;
  padding: 0;
  border-radius: 10px;
  background: #f59e0b;
  font-size: 18px;
  line-height: 1;
}

.qty-controls strong {
  min-width: 24px;
  text-align: center;
}

@media (max-width: 1200px) {
  .menu-grid {
    grid-template-columns: repeat(3, minmax(170px, 1fr));
  }
}

@media (max-width: 900px) {
  .grid {
    grid-template-columns: 1fr;
  }

  .menu-grid {
    grid-template-columns: repeat(2, minmax(150px, 1fr));
  }
}

@media (max-width: 560px) {
  .menu-grid {
    grid-template-columns: 1fr;
  }
}


/* v6.3 sticky separated order panel + professional quantity controls */
.grid {
  align-items: start;
}

.grid > aside.card {
  position: sticky;
  top: 18px;
  max-height: calc(100vh - 36px);
  overflow-y: auto;
  scrollbar-width: thin;
  border: 1px solid rgba(245, 158, 11, .15);
}

.grid > aside.card::-webkit-scrollbar {
  width: 8px;
}

.grid > aside.card::-webkit-scrollbar-thumb {
  background: #f59e0b;
  border-radius: 999px;
}

.cart-row-with-controls {
  display: grid;
  gap: 10px;
  padding: 13px 0;
  border-bottom: 1px solid #eee;
}

.cart-item-main {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 10px;
}

.cart-food-name {
  font-weight: 600;
  line-height: 1.25;
}

.cart-line-price {
  white-space: nowrap;
  font-size: 15px;
}

.cart-item-actions {
  display: inline-grid;
  grid-template-columns: 34px 38px 34px;
  align-items: center;
  justify-content: start;
  gap: 6px;
  background: #fff8ed;
  border: 1px solid #f0ddbd;
  border-radius: 16px;
  padding: 5px;
  width: fit-content;
}

.qty-btn {
  width: 34px;
  height: 32px;
  padding: 0;
  border-radius: 11px;
  background: #f59e0b;
  color: #16120f;
  font-size: 20px;
  font-weight: 900;
  line-height: 1;
}

.qty-btn:hover {
  filter: brightness(.96);
}

.qty-number {
  text-align: center;
  font-size: 16px;
  min-width: 38px;
}

@media (max-width: 900px) {
  .grid > aside.card {
    position: static;
    max-height: none;
    overflow: visible;
  }
}


/* v6.4 inline cart buttons: buttons sit on the same order row */
.cart-row-inline {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 10px;
  padding: 13px 0;
  border-bottom: 1px solid #eee;
}

.cart-info {
  min-width: 0;
  display: grid;
  gap: 4px;
}

.cart-food-name {
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.cart-line-price {
  font-size: 14px;
  white-space: nowrap;
}

.cart-inline-actions {
  display: grid;
  grid-template-columns: 30px 28px 30px;
  align-items: center;
  gap: 5px;
  background: #fff8ed;
  border: 1px solid #f0ddbd;
  border-radius: 14px;
  padding: 4px;
  flex-shrink: 0;
}

.cart-inline-actions .qty-btn {
  width: 30px;
  height: 30px;
  padding: 0;
  border-radius: 10px;
  background: #f59e0b;
  color: #16120f;
  font-size: 18px;
  font-weight: 900;
  line-height: 1;
}

.cart-inline-actions .qty-number {
  min-width: 28px;
  text-align: center;
  font-size: 15px;
}

/* neutralize older vertical cart styles */
.cart-row-with-controls {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
}

.cart-item-actions,
.qty-controls {
  margin-top: 0;
}

@media (max-width: 1100px) {
  .cart-row-inline {
    grid-template-columns: 1fr;
    align-items: start;
  }
}



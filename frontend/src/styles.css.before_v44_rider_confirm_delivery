.kitchen-header {
  background: linear-gradient(135deg, #fff7ed, #ffffff);
  border: 1px solid #fed7aa;
  border-radius: 24px;
  padding: 22px;
  box-shadow: 0 14px 35px rgba(0,0,0,.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kitchen-header h2 {
  display: flex;
  align-items: center;
  gap: 10px;
}

.kitchen-header p {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 0;
  color: #6b7280;
}

.kitchen-header.flash {
  animation: flashPulse 1s ease-in-out infinite;
}

.new-order-banner {
  background: #fef3c7;
  color: #92400e;
  border: 1px solid #f59e0b;
  border-radius: 18px;
  padding: 16px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 10px;
}

.kitchen-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
  gap: 18px;
}

.kitchen-card {
  background: white;
  border-radius: 24px;
  padding: 20px;
  box-shadow: 0 14px 35px rgba(0,0,0,.08);
  border-top: 8px solid #d1d5db;
}

.kitchen-card.status-new {
  border-top-color: #f59e0b;
}

.kitchen-card.status-preparing {
  border-top-color: #3b82f6;
}

.kitchen-card.status-ready {
  border-top-color: #22c55e;
}

.kitchen-card-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}

.kitchen-items {
  background: #f9fafb;
  border-radius: 16px;
  padding: 14px;
  margin: 14px 0;
}

.kitchen-item-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #e5e7eb;
}

.kitchen-item-row:last-child {
  border-bottom: 0;
}

.kitchen-actions {
  display: flex;
  gap: 10px;
  align-items: center;
}

@keyframes flashPulse {
  0% { box-shadow: 0 0 0 rgba(245,158,11,0); }
  50% { box-shadow: 0 0 35px rgba(245,158,11,.45); }
  100% { box-shadow: 0 0 0 rgba(245,158,11,0); }
}

@media (max-width: 900px) {
  .kitchen-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .kitchen-actions {
    flex-direction: column;
    align-items: stretch;
  }
}



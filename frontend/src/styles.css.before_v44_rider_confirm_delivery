.rider-auto-v43-message {
  background: #fef3c7;
  color: #92400e;
  border-radius: 16px;
  padding: 13px;
  font-weight: 900;
}

.rider-auto-v43-waiting,
.rider-auto-v43-order {
  background: white;
  border: 1px solid #fed7aa;
  border-radius: 20px;
  padding: 18px;
}

.rider-auto-v43-waiting strong {
  display: block;
  font-size: 22px;
  margin-bottom: 6px;
}

.rider-auto-v43-waiting p {
  color: #78350f;
  font-weight: 800;
}

.rider-auto-v43-order-head {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  align-items: center;
  margin-bottom: 12px;
}

.rider-auto-v43-order-head strong {
  font-size: 24px;
}

.rider-auto-v43-order-head span {
  background: #dbeafe;
  color: #1d4ed8;
  border-radius: 999px;
  padding: 8px 12px;
  font-weight: 900;
}

.rider-auto-v43-items {
  display: grid;
  gap: 8px;
  margin: 14px 0;
}

.rider-auto-v43-items div {
  display: flex;
  justify-content: space-between;
  background: #fff7ed;
  border-radius: 12px;
  padding: 10px;
  font-weight: 800;
}

.rider-auto-v43-gps {
  background: #dcfce7;
  color: #166534;
  border-radius: 14px;
  padding: 12px;
  font-weight: 900;
  margin: 12px 0;
}

.rider-auto-v43-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.rider-auto-v43-actions .delivered {
  background: #111827;
  color: white;
}

@media (max-width: 700px) {
  .rider-auto-v43-card {
    border-radius: 20px;
    padding: 16px;
  }

  .rider-auto-v43-header,
  .rider-auto-v43-order-head {
    flex-direction: column;
  }

  .rider-auto-v43-actions {
    grid-template-columns: 1fr;
  }
}
